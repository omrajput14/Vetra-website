# ElevenLabs Text-to-Speech API Configuration
# Get your API key at: https://elevenlabs.io/app/speech-synthesis
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: Default Voice ID (Defaults to Sarah: EXAVITQu4vr4xnSDxMaL)
ELEVENLABS_DEFAULT_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Optional: TTS Model ID (Defaults to eleven_multilingual_v2)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
